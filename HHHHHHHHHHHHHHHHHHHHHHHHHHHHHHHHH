function CameraShake(conf,pos:Vector3,_time:number)
	_time = _time or 10
	conf.FadeIn = conf.FadeIn or 0
	conf.FadeOut = conf.FadeOut or .5
	conf.posInfluence = conf.posInfluence or Vector3.new(.5,.5,.5)
	conf.rotInfluence = conf.rotInfluence or Vector3.new(.25,.25,.25)
