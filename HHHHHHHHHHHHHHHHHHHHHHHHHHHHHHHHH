local function crater(args)
	assert(args.Origin, "NO ORIGIN STUPID")

	local orig = typeof(args.Origin) == "Instance" and args.Origin.CFrame or args.Origin
	orig *= (args.Offset or CFrame.new())

	local amt = args.Amount or 30
	if amt <= 0 then return end

	local life = args.Lifetime or 3
	local radius = args.Radius or 20
	local size = args.Size or Vector3.one * 2
	local randomness = args.Influence or 0.5

	local angleStep = 360 / amt
	local angle = 0

	local filter = {script, character}
	if args.Exclude then table.insert(filter, args.Exclude) end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = filter

	local rocks = Instance.new("Model")
	rocks.Name = "Rocks"
	rocks.Parent = workspace

	if args.AttachTo then
		args.BypassDuration = true
		args.AttachTo.Destroying:Connect(function()
			rocks:Destroy()
		end)
	end

	if not args.BypassDuration then
		task.delay(life + 0.5, function()
			if rocks then rocks:Destroy() end
		end)
	end

	for i = 0, amt do
		local angleRad = math.rad(angle)
		local randOffset = Vector3.new(
			nn(-randomness, randomness),
			0,
			nn(-randomness, randomness)
		) * radius * 0.5

		local offset1 = CFrame.Angles(0, angleRad, 0) * CFrame.new(radius * 0.8, 10, 0) + randOffset
		local offset2 = CFrame.Angles(0, angleRad, 0) * CFrame.new(radius * 0.4, 10, 0) + randOffset

		local ray2 = (orig * offset1).Position
		local ra1 = (orig * offset2).Position

		local r1 = workspace:Raycast(ray2, Vector3.yAxis * -20, params)
		local r2 = workspace:Raycast(ra1, Vector3.yAxis * -20, params)

		if r1 and r2 then
			local basePart = Instance.new("Part")
			basePart.Anchored = true
			basePart.CanCollide = false
			basePart.CanQuery = false
			basePart.CanTouch = false
			basePart.Material = r1.Material
			basePart.Color = r1.Instance.Color
			basePart.TopSurface = Enum.SurfaceType.Smooth
			basePart.BottomSurface = Enum.SurfaceType.Smooth

			for _, tex in pairs(r1.Instance:GetChildren()) do
				if tex:IsA("Texture") then
					for _, face in pairs(Enum.NormalId:GetEnumItems()) do
						local cloned = tex:Clone()
						cloned.Face = face
						cloned.Parent = basePart
					end
				end
			end

			local rockSize = Vector3.new(size.X * 1.3, size.Y / 1.4, size.Z * 1.3) * nn(1, 1.5)
			local rockCFrame = CFrame.new(r1.Position - Vector3.yAxis / 2, orig.Position) *
				CFrame.Angles(nn(-.25, .5), nn(-.25, .25), nn(-.25, .25))
			t(basePart, rockSize, rockCFrame, rocks)

			local stoneSize = Vector3.new(rockSize.X * 1.01, rockSize.Y * .25, rockSize.Z * 1.01)
			local stoneCFrame = rockCFrame * CFrame.new(0, rockSize.Y / 2 - stoneSize.Y / 2.1, 0)
			t(basePart, stoneSize, stoneCFrame, rocks)

			local rubbleCFrame = CFrame.new(r2.Position - (Vector3.yAxis * size * 0.4), orig.Position) *
				CFrame.Angles(nn(-1, -.3), nn(-.15, .15), nn(-.15, .15))
			local rubbleSize = rockSize * nn(0.85, 1.15)
			t(basePart, rubbleSize, rubbleCFrame, rocks)

			local pebbleCFrame = rubbleCFrame * CFrame.new(0, rubbleSize.Y / 2 - stoneSize.Y / 2.1, 0)
			t(basePart, stoneSize, pebbleCFrame, rocks)
		end

		angle += angleStep
	end

	if not args.BypassDuration then
		task.delay(life, function()
			for _, v in pairs(rocks:GetChildren()) do
				ts:Create(v, TweenInfo.new(1), {
					Size = Vector3.zero,
					Position = v.Position - Vector3.yAxis * (v.Size.Y + 2)
				}):Play()
			end
		end)
	end
end


local function ragdoll(c, t)
	local ps = game:GetService("PhysicsService")

	if not ps:IsCollisionGroupRegistered("Players") then
		ps:RegisterCollisionGroup("Players")
	end

	if not ps:IsCollisionGroupRegistered("Collider") then
		ps:RegisterCollisionGroup("Collider")
	end

	ps:CollisionGroupSetCollidable("Players", "Collider", false)

	local hum = c:FindFirstChildOfClass("Humanoid")
	local hrp = c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso")

	if not hrp or not hum then
		return
	end

	local existingCollider = c:FindFirstChild("ColliderFolder")
	if existingCollider then
		local existingTimer = existingCollider:FindFirstChild("RagdollTimer")
		if existingTimer then
			existingTimer.Value = existingTimer.Value + 5
		end
		return
	end

	local cs = Instance.new("Folder", c)
	cs.Name = "ColliderFolder"

	local ragdollTimer = Instance.new("NumberValue")
	ragdollTimer.Name = "RagdollTimer"
	ragdollTimer.Value = t or 5
	ragdollTimer.Parent = cs

	local old = hum.RequiresNeck

	hum.PlatformStand = true
	hum.RequiresNeck = false
	hum.BreakJointsOnDeath = false

	local ragdollParts = {}

	for _, v in pairs(c:GetDescendants()) do
		if v:IsA("Motor6D") and v.Name ~= "RootJoint" and v.Name ~= "Root" then
			local part0, part1 = v.Part0, v.Part1
			if not part0 or not part1 then continue end

			local bcs = Instance.new("BallSocketConstraint", part0)
			bcs.Name = "RagdollSocket"
			part1.CanCollide = false
			part0.CanCollide = false
			part1.CollisionGroup = "Players"

			local fake = Instance.new("Part", cs)
			fake.Transparency = 1
			fake.Massless = true
			fake.CanCollide = false
			fake.Name = part1.Name
			fake.Size = part1.Size / 2
			fake.CFrame = part1.CFrame
			fake.CollisionGroup = "Collider"

			local w = Instance.new("WeldConstraint", fake)
			w.Part0 = part1
			w.Part1 = fake

			local a1 = Instance.new("Attachment", part0)
			a1.Name = "RagdollAttachment"
			local a2 = Instance.new("Attachment", part1)
			a2.Name = "RagdollAttachment"

			a2.Position = v.C1.Position
			a1.WorldPosition = a2.WorldPosition

			bcs.LimitsEnabled = true
			bcs.TwistLimitsEnabled = true

			bcs.Attachment0 = a1
			bcs.Attachment1 = a2

			table.insert(ragdollParts, { bcs, fake, a1, a2, w, v })
			
			if v.Name == "Neck" or v.Part0 == hrp or v.Part1 == hrp then
				local torsoWeld = Instance.new("WeldConstraint", hrp)
				torsoWeld.Part0 = hrp
				torsoWeld.Part1 = (hrp == v.Part1 and v.Part0 or v.Part1)
				table.insert(ragdollParts, { torsoWeld })
			else
				v.Enabled = false
				fake.CanCollide = true
			end
		end
	end

	task.spawn(function()
		while ragdollTimer and ragdollTimer.Value > 0 do
			task.wait(1)
			ragdollTimer.Value = ragdollTimer.Value - 1
		end

		if cs.Parent then
			hum.RequiresNeck = old
			hum.PlatformStand = false

			for _, data in pairs(ragdollParts) do
				local bcs, fake, a1, a2, w, motor = unpack(data)
				if motor then motor.Enabled = true end
				if bcs then bcs:Destroy() end
				if fake then fake:Destroy() end
				if a1 then a1:Destroy() end
				if a2 then a2:Destroy() end
				if w then w:Destroy() end
			end

			cs:Destroy()
		end
	end)
end

