function Replicate(root: BasePart | CFrame, radius: number, func: (Player, ...any) -> (), ...)
	for _, player in game:GetService("Players"):GetPlayers() do
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if hrp then
			local pos = typeof(root) == "CFrame" and root.Position or root.Position
			if (hrp.Position - pos).Magnitude <= radius then
				func(player, ...)
			end
		end
	end
end

local function looper(func, times, delay, ...)
	local args = {...}
	for _ = 1, times do
		func(table.unpack(args))
		task.wait(delay)
	end
end

