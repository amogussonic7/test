--[[local function FindFirstDescendantOfClass(classname, instance)
    for _, v in ipairs(instance:GetDescendants()) do
        if v.ClassName == classname then
            return v
        end
    end
    return nil
end

local function insert(id, char)
    local classes = {"Accessory", "Decal", "CharacterMesh", "Shirt", "Pants", "ShirtGraphic"}
    local model = nil

    local success, asset = pcall(function()
        return game:GetService("InsertService"):LoadAsset(id)
    end)

    if success and asset then
        asset.Parent = char
        model = asset

        for _, class in ipairs(classes) do
            local item = FindFirstDescendantOfClass(class, model)
            if item then
                return item
            end
        end
    end
    return nil
end]]

