end
function shoot(val)
	local dmg = 10
	local distance = 200
	local pos = (HRP.CFrame*CFrame.new(0,0.95,-5)).Position
	local pos2 = (HRP.CFrame*CFrame.new(0,0,-distance)).Position
	if val == true then
		pos2 = (HRP.CFrame*CFrame.new(-0.25,0.95,-distance)).Position
		pos = (HRP.CFrame*CFrame.new(-0.25,0.95,-4.5)).Position
	end
	local cf 
	local dist
	local s
	local part
	local tag = Char.Name.."_HitTag_"..math.random(-9999,9999)
	local mag = (pos-pos2).Magnitude
	local result = workspace:Raycast(pos,HRP.CFrame.LookVector*mag,Params)
	if result then
		dist = (pos-result.Position).Magnitude
		s = Vector3.new(dist, 2, 2)
		if val == true then
			s = Vector3.new(dist, 5, 5)
		end
		if workspace:FindFirstChildOfClass('Terrain') then
			local ter = workspace:FindFirstChildOfClass('Terrain')
			local attach = Instance.new("Attachment",ter)
			attach.WorldPosition = result.Position
			for _,v in pairs(Assets:WaitForChild('bullethit'):GetChildren())do
				local e = v:Clone()
				e.Parent = attach
				e:Emit(v:GetAttribute('EmitCount'))
			end
			game:GetService('Debris'):AddItem(attach,1)
		end
		cf = CFrame.new(pos, result.Position) * CFrame.Angles(0,math.rad(-90),0) * CFrame.new(-dist/2,0,0);
	else
		dist = (pos-pos2).Magnitude
		s = Vector3.new(dist, 2, 2)
		if val == true then
			s = Vector3.new(dist, 5, 5)
		end
		cf = CFrame.new(pos, pos2) * CFrame.Angles(0,math.rad(-90),0) * CFrame.new(-dist/2,0,0);
	end
	local Targets = Hitbox.Hitbox('Box',cf,s,Overlap)
	for _,v in pairs(Targets)do
		if not v.Parent:FindFirstChild(tag) and not v.Parent:FindFirstChild("IFrame") then
			AddTag(v.Parent,tag,0.3)
			v:TakeDamage(math.random(7,12))
			if v.Parent:FindFirstChild("HumanoidRootPart") then
				local THRP = v.Parent:FindFirstChild("HumanoidRootPart")
				if val == true then
					AddVelo(
						THRP,
						0.15,
						Vector3.new(50000,0,50000),
						(HRP.CFrame.LookVector*50)
					)
				else
					AddVelo(
						THRP,
						0.15,
						Vector3.new(50000,0,50000),
						(HRP.CFrame.LookVector*10)
					)
				end
				if workspace:FindFirstChildOfClass('Terrain') then
					local ter = workspace:FindFirstChildOfClass('Terrain')
					local attach = Instance.new("Attachment",ter)
					attach.WorldPosition = THRP.Position
					for _,v in pairs(script:WaitForChild('bullethit'):GetChildren())do
						local e = v:Clone()
						e.Parent = attach
						e:Emit(v:GetAttribute('EmitCount'))
					end
					game:GetService('Debris'):AddItem(attach,1)
				end
			end
		end
	end
end

