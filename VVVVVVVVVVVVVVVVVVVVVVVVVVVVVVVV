function AddVelo(parent,duration,force,velocity)
	local velo = Instance.new("BodyVelocity",parent)
	velo.MaxForce = force
	velo.Velocity = velocity
	game:GetService('Debris'):AddItem(velo,duration)
end
function AddTag(parent,name,duration)
