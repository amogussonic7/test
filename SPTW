				v.Enabled = true
				v.Color = ColorSequence.new(Color3.new(1, 1, 0))
				task.wait(length * .8)

				v.Enabled = false
			elseif v:IsA("Trail") then
				v.Color = ColorSequence.new(Color3.new(1, 1, 0))
			end
		end)()
	end

	coroutine.wrap(function()
		owner.Character:SetAttribute("Resolve", true)
		task.wait(length)

		task.delay(3, theme.Destroy, theme)
		owner.Character:SetAttribute("Resolve", false)
		game:GetService("TweenService"):Create(theme, TweenInfo.new(3), {Volume = 0}):Play()

