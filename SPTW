local function debrisfx()
	local dist = owner.Character.HumanoidRootPart.CFrame
	dist = (owner.Character.HumanoidRootPart.Position - dist.Position).Magnitude

	--[[
	if dist < 15 and not CancelShake then
		if player.Settings["CameraShake"].Value == false then print('No Camera Shake') return end
		local camShake = cameraShaker.new(Enum.RenderPriority.Camera.Value, function(shakeCFrame)
			playerCamera.CFrame = playerCamera.CFrame * shakeCFrame
		end)

		camShake:Stop()
		camShake:Start()
		camShake:Shake(cameraShaker.Presets.Explosion2)
	end
	]]--

	local debris = templates.DebrisImpact:Clone()
	debris.Parent = script
	debris:SetPrimaryPartCFrame(owner.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, -5) * CFrame.Angles(0, math.rad(Random.new():NextNumber(-360, 360)), 0))

	local params = RaycastParams.new()
	params.FilterDescendantsInstances = {owner.Character, script}
	params.FilterType = Enum.RaycastFilterType.Blacklist

	local ray = workspace:Raycast(debris.Primary.Position, Vector3.new(0, -10, 0), params)

	if ray then
		local rot = debris.PrimaryPart.CFrame - debris.PrimaryPart.Position
		local ncf = CFrame.new(ray.Position + Vector3.new(0, 3, 0)) * rot

		debris:SetPrimaryPartCFrame(ncf)
	else
		debris:Destroy()
		return
	end

	for _, v in ipairs(debris:GetChildren()) do
		if v.Name ~= "Primary" and v.Name ~= "Crack" then
			if ray and ray.Instance then
				v.Material = ray.Material

				if ray.Instance.Parent.Name == "LeftToStart" then
					v.Color = Color3.new(.0235294, .0235294, .0235294)
				else
					v.Color = ray.Instance.Color
				end
			end

			local rndb = 3 * Random.new():NextInteger(-1, 0)

			if rndb == 0 then
				rndb += 3
			end

			local p = v:Clone()
			p.Parent = script
			p.Anchored = false
			p.CanCollide = false
			p.Size = Vector3.new(Random.new():NextNumber(1, 2), Random.new():NextNumber(1, 2), Random.new():NextNumber(1, 2))
			p.CFrame = debris.Primary.CFrame * CFrame.Angles(math.rad(Random.new():NextNumber(-360, 360)), math.rad(Random.new():NextNumber(-360, 360)), math.rad(Random.new():NextNumber(-360, 360)))

			local bp = Instance.new("BodyPosition", p)
			bp.MaxForce = Vector3.new(100000, 100000, 100000)
			bp.Position = debris.Primary.CFrame * CFrame.new(Random.new():NextNumber(-2, 2), Random.new():NextNumber(-1, 1), Random.new():NextNumber(-2, 2)) * CFrame.new(Random.new():NextNumber(-25, 25), Random.new():NextNumber(1, 25), Random.new():NextNumber(-25, 25)).Position

			coroutine.wrap(function()
				task.wait(.25)

				bp:Destroy()
				p.CanCollide = true
				task.wait(5)

				p:Destroy()
			end)()
		end
	end

	task.wait(5)

	for _, v in pairs(debris:GetChildren()) do
		v.Anchored = false
		v.CanCollide = false

		task.wait(.1)
		coroutine.wrap(function()
			task.wait(2)
			v:Destroy()
		end)()
	end
end

