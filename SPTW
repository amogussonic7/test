		})
	end

	task.wait(2.2)

	for _, v in pairs(owner.Character:GetDescendants()) do
		if v.Name == "StandAura" then
			v.Enabled = true
		end
	end

	local theme = play("Theme", owner.Character.HumanoidRootPart)

	coroutine.wrap(function()
		taunt({
			["Text"] = "After seeing something like that!",
			["SoundId"] = "",
			["StallTime"] = 3,
		})
	end)()

	local length = 20 + 5

	local et = templates.EyeTrails:Clone()
	et.Parent = script

	local efsp = templates.EyeFlameSP:Clone()
	efsp.Parent = script

	local w1 = Instance.new("Weld", owner.Character)
	w1.Part0 = et
	w1.Part1 = owner.Character.Head

	local w2 = Instance.new("Weld", owner.Character)
	w2.Part0 = efsp
	w2.Part1 = owner.Character.Head

	task.delay(length, et.Destroy, et)
	task.delay(length, efsp.Destroy, efsp)

	for _, v in pairs(et:GetDescendants()) do
		coroutine.wrap(function()
			if v:IsA("ParticleEmitter") or v:IsA("Beam") and v.Enabled == false then
				v.Enabled = true
				v.Color = ColorSequence.new(Color3.new(1, 1, 0))
				task.wait(length * .8)

				v.Enabled = false
			elseif v:IsA("Trail") then
				v.Color = ColorSequence.new(Color3.new(1, 1, 0))
			end
		end)()
	end

	for _, v in pairs(efsp:GetDescendants()) do
