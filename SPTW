local function taunt(data)
	local h = owner.Character.Head

	local ui

	if not h:FindFirstChild("Taunt") then
		ui = templates.Taunt:Clone()
		ui.Parent = h
		ui.TextBox.Text = ""
		ui.TextBox.TextTransparency = 1
	else
		ui = h:FindFirstChild("Taunt")
	end

	if ui and ui.TextBox.Text ~= "" then
		return
	end

	game:GetService("TweenService"):Create(ui.TextBox, TweenInfo.new(.5), {TextTransparency = 0}):Play()

	local snd = Instance.new("Sound", owner.Character.Head)
	snd.SoundId = data.SoundId
	snd.RollOffMinDistance = 20
	snd.RollOffMaxDistance = 200
	snd.Volume = data.Volume or .75
	snd.RollOffMode = "InverseTapered"

	if data.SoundId ~= "" then
		repeat
			task.wait()
		until snd.TimeLength > 0
	end

	if snd.TimeLength > 0 and data.SoundId ~= "" then
		snd:Play()
		task.delay(snd.TimeLength + 1, snd.Destroy, snd)
	end

	for i = 1, string.len(data.Text) do
		task.wait(.03)
		ui.TextBox.Text = string.sub(data.Text, 1, i)

		if data.Timings ~= nil then
			for part, time in pairs(data.Timings) do
				if string.match(ui.TextBox.Text, part) then
					data.Timings[part] = nil
					task.wait(time)
				end
			end
		end
	end

	task.wait(data.StallTime or 1.5)

	ui.TextBox.TextTransparency = 0
	ui.TextBox.Text = ""
	snd:Destroy()
end

local function ragdoll(c, t)
	local hum = c:FindFirstChildOfClass("Humanoid")
	local hrp = c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso")

	local cs = Instance.new("Folder", c)
	cs.Name = "ColliderFolder"

	hum.PlatformStand = true
	for _,v in pairs(c:GetDescendants()) do
		if v:IsA("Motor6D") or v:IsA("Motor") then
			local bcs = Instance.new("BallSocketConstraint", v.Part0)
			bcs.Name = "RagdollSocket"
			v.Part1.CanCollide = false
			v.Part0.CanCollide = false

			game:GetService("PhysicsService"):SetPartCollisionGroup(v.Part1, "Players")

			local fake = Instance.new("SpawnLocation", cs)
			fake.Enabled = false
			fake.Transparency = 1
			fake.Massless = true
			fake.CanCollide = false
			fake.Name = v.Part1.Name
			fake.Size = v.Part1.Size / 2
			fake.CFrame = v.Part1.CFrame

			game:GetService("PhysicsService"):SetPartCollisionGroup(fake, "Collider")

			local w = Instance.new("WeldConstraint",fake)
			w.Part0 = v.Part1
			w.Part1 = fake

			local a1 = Instance.new("Attachment", v.Part0)
			a1.Name = "RagdollAttachment"
			local a2 = Instance.new("Attachment", v.Part1)
			a2.Name = "RagdollAttachment"

			a2.Position = v.C1.Position
			a1.WorldPosition = a2.WorldPosition

			bcs.LimitsEnabled = true
			bcs.TwistLimitsEnabled = true

			bcs.Attachment0 = a1
			bcs.Attachment1 = a2

			local w

			if v.Part0 ~= c.PrimaryPart and v.Part1 ~= c.PrimaryPart then
				fake.CanCollide = true
				v.Enabled = false
			else
				local w = Instance.new("WeldConstraint", hrp)
				w.Part0 = c.PrimaryPart
				w.Part1 = c.PrimaryPart == v.Part1 and v.Part0 or v.Part1
				w.Enabled = true
			end

			coroutine.wrap(function()
				if t ~= nil and tonumber(t) ~= nil then
					task.wait(t)
					hum.PlatformStand = false

					fake:Destroy()
					v.Enabled = true

					if w then
						w.Enabled = false
					end
				end
			end)()
		end
	end
end

