local function hb(pt, cf, size, bl, type)
	return rf:InvokeClient(owner, pt, cf, size, bl, type)
end

local function play(what, p)
	if sounds[what] then
		local snd = sounds[what]:Clone()
		snd.Name = what
		snd.Parent = p or stand.StandHumanoidRootPart
		snd:Play()

		coroutine.wrap(function()
			snd.Ended:Wait()
			snd:Destroy()
		end)()

		return snd
	end
end

local function findhum(p)
	if p:FindFirstAncestorOfClass("Model") then
		if p:FindFirstAncestorOfClass("Model"):FindFirstChildOfClass("Humanoid") then
			return p:FindFirstAncestorOfClass("Model"):FindFirstChildOfClass("Humanoid")
		else
			return nil
		end
	else
		return nil
	end
end

local function dmgui(mdl, dmg)
	if mdl:GetAttribute("DeadNotBigSurprise") == true then
		return
	end

	local ui = mdl:FindFirstChild("DamageGUI")

	if ui then
		local tb = ui.BBG.TextBox

		local ogdmg = tonumber(tb.Text) or 0
		ogdmg += dmg

		local txt

		if math.floor(ogdmg) == ogdmg then
			txt = tostring(ogdmg)
		else
			txt = string.format("%.1f", tostring(ogdmg))
		end

		if ogdmg > 100 then
			tb.Text = overtxts[Random.new():NextInteger(1, table.getn(overtxts))]
			ui.Name = "DisabledDamageGUI"
		elseif mdl:FindFirstChildWhichIsA("Humanoid", true).Health <= 0 then
			tb.Text = killtxts[Random.new():NextInteger(1, table.getn(killtxts))]
			ui.Name = "DisabledDamageGUI"

			mdl:SetAttribute("DeadNotBigSurprise", true)
		else
			tb.Text = txt
		end

		ui.BBG.Size = UDim2.new(10, 0, 2, 0)

		tb.TextTransparency = 0
		tb.TextStrokeTransparency = 0

		local hrp = (dbs.BeatdownActive == true and mdl:FindFirstChild("Torso") or mdl:FindFirstChild("HumanoidRootPart"))

		ui.CFrame = hrp.CFrame * CFrame.new(Random.new():NextNumber(-1, 1), Random.new():NextNumber(-1, 1), Random.new():NextNumber(-1, 1))

		local inf1 = TweenInfo.new(.5, Enum.EasingStyle.Cubic,Enum.EasingDirection.Out)
		local inf2 = TweenInfo.new(3, Enum.EasingStyle.Quint, Enum.EasingDirection.In)

		game:GetService("TweenService"):Create(ui.BBG, inf1, {Size = UDim2.new(5, 0, 1, 0)}):Play()
		game:GetService("TweenService"):Create(tb, inf1, {Rotation = Random.new():NextNumber(-15, 15)}):Play()

		game:GetService("TweenService"):Create(ui, inf2, {CFrame = ui.CFrame * CFrame.new(0, -4, 0)}):Play()
		game:GetService("TweenService"):Create(tb, inf2, {TextTransparency = 1, TextStrokeTransparency = 1}):Play()
	else
		local ui = templates.DamageGUI:Clone()
		ui.Parent = mdl

		local txt

		if math.floor(dmg) == dmg then
			txt = tostring(dmg)
		else
			txt = string.format("%.1f", tostring(dmg))
		end

		local tb = ui.BBG.TextBox
		tb.Text = txt

		if mdl:FindFirstChildWhichIsA("Humanoid", true).Health <= 0 then
			tb.Text = killtxts[Random.new():NextInteger(1, table.getn(killtxts))]
			ui.Name = "DisabledDamageGUI"

			mdl:SetAttribute("DeadNotBigSurprise", true)
		end

		ui.BBG.Size = UDim2.new(10, 0, 2, 0)

		tb.TextTransparency = 0
		tb.TextStrokeTransparency = 0

		local hrp = (dbs.BeatdownActive == true and mdl:FindFirstChild("Torso") or mdl:FindFirstChild("HumanoidRootPart"))

		ui.CFrame = hrp.CFrame * CFrame.new(Random.new():NextNumber(-1, 1), Random.new():NextNumber(-1, 1), Random.new():NextNumber(-1, 1))

		local inf1 = TweenInfo.new(.5, Enum.EasingStyle.Cubic,Enum.EasingDirection.Out)
		local inf2 = TweenInfo.new(3, Enum.EasingStyle.Quint, Enum.EasingDirection.In)

		game:GetService("TweenService"):Create(ui.BBG, inf1, {Size = UDim2.new(5, 0, 1, 0)}):Play()
		game:GetService("TweenService"):Create(tb, inf1, {Rotation = Random.new():NextNumber(-15, 15)}):Play()

		game:GetService("TweenService"):Create(ui, inf2, {CFrame = ui.CFrame * CFrame.new(0, -4, 0)}):Play()
		game:GetService("TweenService"):Create(tb, inf2, {TextTransparency = 1, TextStrokeTransparency = 1}):Play()

		coroutine.wrap(function()
			repeat
				task.wait()
			until tb.TextTransparency >= .99

			ui:Destroy()
		end)()
	end
end

local function stun(hum, t)
	if t == 0 or nil then
		return
	end

	coroutine.wrap(function()
		local mdl = hum:FindFirstAncestorOfClass("Model")
		local sc = mdl:GetAttribute("StunCounter") or 0
		mdl:SetAttribute("StunCounter", sc + 1)

		local ows = 16 -- // hum:GetAttribute("OriginalWalkspeed") or hum.WalkSpeed
		hum:SetAttribute("OriginalWalkspeed", ows)

		hum.WalkSpeed = .5

		mdl:SetAttribute("Stunned", true)

		if not mdl:FindFirstChild("StunGUI") and dbs.BeatdownActive == false then
			local ui = templates.DamageGUI.BBG:Clone()
			ui.Name = "StunGUI"
			ui.Parent = mdl
			ui.TextBox.Text = "STUNNED"
			ui.ClipsDescendants = false
			ui.Size = UDim2.fromScale(3, 1.5)
			ui.Adornee = mdl.HumanoidRootPart
			ui.StudsOffset = Vector3.new(0, 3, 0)
		end

		coroutine.wrap(function()
			repeat
				hum:UnequipTools()
				task.wait()
			until mdl:GetAttribute("StunCounter") == 0
		end)()

		task.wait(t)

		if mdl:GetAttribute("StunCounter") ~= sc + 1 then
			return
		end

		mdl:SetAttribute("StunCounter", 0)

		if mdl:FindFirstChild("StunGUI") then
			mdl.StunGUI:Destroy()
		end

		hum:FindFirstAncestorOfClass("Model"):SetAttribute("Stunned", false)

		hum.WalkSpeed = ows
	end)()
end

local function ghit(p, n)
	local cf = p.CFrame

	local h1 = templates.HitEffects.Hit:Clone()
	local h2 = templates.HitEffects.Hit3:Clone()
	local h3 = templates.HitEffects.HitPE:Clone()

	for i = 1, 10 do
		coroutine.wrap(function()
			local lv = cf * CFrame.Angles(math.rad(Random.new():NextNumber(0, 360)), 0, math.rad(Random.new():NextNumber(0, 360)))

			local h = h1:Clone()
			h.Size = Vector3.new(Random.new():NextNumber(.1, .3), Random.new():NextNumber(1, 3), Random.new():NextNumber(.1, .3)) * 1.5
			h.CFrame = lv * CFrame.new(0, h.Size.Y / 2, 0)
			h.Parent = script

			local tw = game:GetService("TweenService"):Create(h, TweenInfo.new(.5), {CFrame = h.CFrame * CFrame.new(0, Random.new():NextNumber(3, 8), 0), Size = Vector3.new(), Transparency = 1})
			tw:Play()

			coroutine.wrap(function()
				tw.Completed:Wait()
				h:Destroy()
			end)()
		end)()
	end

	h2.CFrame = cf
	h2.Parent = script

	h3.Parent = p
	h3:Emit(n or 2)

	for _, v in ipairs(h2.Attachment:GetChildren()) do
		v.Brightness = 10
		v:Emit(25)
	end

	task.delay(.5, function()
		h2:Destroy()
		h3:Destroy()
	end)
end

local function hfx(t, victim, ep)
	local ep = ep or victim.HumanoidRootPart

	if t == "Light" then
		local spl = templates.HitEffects.Light:Clone()
		spl.CFrame = CFrame.new(ep.CFrame.Position, owner.Character.HumanoidRootPart.CFrame.Position) * CFrame.Angles(math.random(), math.random(), math.random())
		spl.CFrame *= CFrame.new(Random.new():NextNumber(-1, .5), Random.new():NextNumber(-.5, 1), Random.new():NextNumber(-1, .5))
		spl.Parent = script

		game:GetService("TweenService"):Create(spl, TweenInfo.new(3, Enum.EasingStyle.Cubic), {Size = Vector3.new(2, 10, 1), Transparency = 1}):Play()

		task.delay(.2, spl.Destroy, spl)
		ghit(ep)
	elseif t == "Heavy" then
		ghit(ep, 25)

		local h = templates.HitEffects.Heavy:Clone()
		h.Parent = script
		h.CFrame = ep.CFrame

		for _, v in ipairs(h.Attachment:GetChildren()) do
			v.Color = ColorSequence.new(Color3.new(1, 1, 1))
			v.Brightness = 10

			v:Emit(15)
		end

		task.delay(1, h.Destroy, h)
	elseif t == "ArmCrush" then
		local di1 = templates.DonutImpact1:Clone()
		di1.Parent = script
		di1.CFrame = ep.CFrame * CFrame.Angles(math.rad(Random.new():NextNumber(-360, 360)), math.rad(Random.new():NextNumber(-360, 360)), math.rad(Random.new():NextNumber(-360, 360)))

		game:GetService("TweenService"):Create(di1, TweenInfo.new(1, Enum.EasingStyle.Circular, Enum.EasingDirection.Out), {Transparency = 1, Size = di1.Size * 2}):Play()
		task.delay(1, di1.Destroy, di1)


		local di2 = templates.DonutImpact2:Clone()
		di2.Parent = script
		di2.CFrame = ep.CFrame * CFrame.Angles(math.rad(Random.new():NextNumber(-360, 360)), math.rad(Random.new():NextNumber(-360, 360)), math.rad(Random.new():NextNumber(-360, 360)))

		game:GetService("TweenService"):Create(di2, TweenInfo.new(1, Enum.EasingStyle.Circular, Enum.EasingDirection.Out), {Transparency = 1, Size = di2.Size * 2}):Play()
		task.delay(1, di2.Destroy, di2)

		for _ = 1, 14 do
			local btrl = templates.WaterBeamIn:Clone()
			btrl.Parent = script
			btrl.Color = Color3.new(1, 1, 1)
			btrl.Size = Vector3.new(btrl.Size.X, btrl.Size.Y, Random.new():NextNumber(3, 8))
			btrl.CFrame = ep.CFrame * CFrame.Angles(math.rad(Random.new():NextNumber(-360, 360)), math.rad(Random.new():NextNumber(-360, 360)), math.rad(Random.new():NextNumber(-360, 360)))

			game:GetService("TweenService"):Create(btrl, TweenInfo.new(.5, Enum.EasingStyle.Circular, Enum.EasingDirection.Out), {CFrame = btrl.CFrame * CFrame.new(0, 0, -(Random.new():NextNumber(6, 12)))}):Play()

			coroutine.wrap(function()
				task.wait(.25)
				game:GetService("TweenService"):Create(btrl, TweenInfo.new(.25, Enum.EasingStyle.Circular, Enum.EasingDirection.Out), {Transparency = 1}):Play()
			end)()

			task.delay(1, btrl.Destroy, btrl)
		end

		local p = Instance.new("Part", script)
		p.Anchored = false
		p.Material = "Neon"
		p.CanCollide = false
		p.Color = Color3.new(1, 1, 1)
		p.Size = ep.Size
		p.CFrame = ep.CFrame

		local w = Instance.new("Weld", ep)
		w.Part0 = ep
		w.Part1 = p

		game:GetService("TweenService"):Create(w.Part1, TweenInfo.new(.4, Enum.EasingStyle.Circular, Enum.EasingDirection.Out), {Size = w.Part1.Size * 3, Transparency = 1}):Play()

		task.delay(1, p.Destroy, p)
		task.delay(1, w.Destroy, w)
	end
end

local function attack(tbl, stats)
	local victims = tbl
	local dist = math.huge

	if table.getn(victims) ~= 0 then
		local snd = stats.Sound or "HitSFX"

		if stats.Sound then
			if typeof(stats.Sound) == "table" then
				snd = stats.Sound[Random.new():NextInteger(1, table.getn(stats.Sound))]
			end
		end

		play(snd)
	end

	local mult = (owner.Character:GetAttribute("Resolve") == true and 1.2 or 1)

	for _, victim in pairs(victims) do
		local hum, hrp = victim:FindFirstChildWhichIsA("Humanoid", true), victim:FindFirstChild("HumanoidRootPart", true)

		hum.Health -= (stats.Damage or 0) * mult

		dmgui(victim, stats.Damage * mult)

		stun(hum, stats.Stun)

		if stats.Animation and hum.RigType == Enum.HumanoidRigType.R6 then
			coroutine.wrap(function()
				AnimationHandler:Animate({
					["Rig"] = victim,
					["StallTime"] = .2,
					["DisableWelds"] = true,
					["Animation"] = stats.Animation
				})
			end)()
		end

		if stats.Knockback then
			local bv = Instance.new("BodyVelocity", hrp)
			bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge) -- // Vector3.new(1, 1, 1) * stats.Knockback[1]
			bv.Velocity = (owner.Character.HumanoidRootPart.CFrame.lookVector * stats.Knockback[1]) + (stats.Knockback[3] or Vector3.new())

			task.delay(stats.Knockback[2], function()
				bv:Destroy()
			end)
		end

		coroutine.wrap(hfx)(stats.HitEffect or "Light", victim, stats.EffectPart)
	end
end

local function summon()
	if dbs.Summon == true then
		return
	end

	if dbs.Stunned == true then
		return
	end

	dbs.Stunned = true
	dbs.Summon = true

	if dbs.Summoned == false then
		dbs.Summoned = true

		for _, v in pairs(stand:GetDescendants()) do
			if (v:IsA("BasePart") or v:IsA("Decal") or v:IsA("Texture")) and not v:GetAttribute("Transparency") and v.Name ~= "StandHumanoidRootPart" then
				game:GetService("TweenService"):Create(v, TweenInfo.new(.3), {Transparency = 0}):Play()
			end
		end

		for _, v in pairs(owner.Character:GetChildren()) do
			if v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" and not v:FindFirstChild("StandAura") then
				local aura = templates.StandAura:Clone()

				for _, v2 in pairs(aura:GetChildren()) do
					v2.Color = ColorSequence.new{
						ColorSequenceKeypoint.new(0, Color3.new(1, 1, 0)),
						ColorSequenceKeypoint.new(1, Color3.new(1, 1, 1))
					}

					v2.Enabled = true
					v2.Parent = v
				end
			end
		end

		AnimationHandler:Animate({
			["Rig"] = stand,
			["Wrapped"] = true,
			["Looping"] = true,
			["Animation"] = anims.StandIdle.Normal
		})

		play("SummonEffects")
		play("SummonVoiceline")

		if stand:FindFirstChild("Stand Torso") then
			if stand["Stand Torso"]:FindFirstChild("SummonParticle") then
				for i, v in pairs(stand["Stand Torso"].SummonParticle:GetChildren()) do
					v.LockedToPart = true
					v:Emit(v.Rate)
				end
			end
		end

		for _, v in pairs(stand:GetDescendants()) do
			if v.Name == "StandAura" then
				v.Enabled = true
			end
		end

		for _, v in pairs(owner.Character:GetDescendants()) do
			if v.Name == "StandAura" then
				v.Enabled = true
			end
		end
	elseif dbs.Summoned == true then
		dbs.Summoned = false

		for _, v in pairs(stand:GetDescendants()) do
			if v.Name == "StandAura" then
				v.Enabled = false
			end
		end

		for _, v in pairs(owner.Character:GetDescendants()) do
			if v.Name == "StandAura" then
				v.Enabled = false
			end
		end

		play("Unsummon")

		AnimationHandler:Stop({
			["Rig"] = stand,
			["FadeTime"] = .3,
			["Wrapped"] = true,
			["Animation"] = anims.StandIdle.Normal
		})

		for _, v in pairs(stand:GetDescendants()) do
			if v:IsA("BasePart") or v:IsA("Decal") or v:IsA("Texture") then
				game:GetService("TweenService"):Create(v, TweenInfo.new(.3), {Transparency = 1}):Play()
			end
		end
	end
	task.delay(.3, function()
		dbs.Stunned = false
		task.wait(cds.Summon - .3)

		dbs.Summon = false
	end)
end

local function combo()
	if dbs.LMBCombo == true then
		return
	end

	if dbs.Stunned == true then
		return
	end

	dbs.Stunned = true

	coroutine.wrap(function()
		if AnimationHandler._Animations[owner.Character] == nil then
			AnimationHandler._Animations[owner.Character] = {}
		end

		if lmbc == 1 and AnimationHandler._Animations[owner.Character][anims.AttackPoseTransition] == nil then
			AnimationHandler:ToggleWelds(nil, true, true)
			AnimationHandler:ToggleWelds(nil, false, false)
			AnimationHandler:ToggleWelds(nil, true, true)

			AnimationHandler:Animate({
				["DisableWelds"] = true,
				["Animation"] = anims.AttackPoseTransition
			})
		end
	end)()

	if dbs.Summoned == false then
		task.delay(.2, function()
			for _, v in pairs(owner.Character:GetDescendants()) do
				if v.Name == "StandAura" then
					v.Enabled = true
				end
			end

			for _, v in pairs(stand:GetDescendants()) do
				if (v:IsA("BasePart") or v:IsA("Decal") or v:IsA("Texture")) and not v:GetAttribute("Transparency") and v.Name ~= "StandHumanoidRootPart" then
					game:GetService("TweenService"):Create(v, TweenInfo.new(.3), {Transparency = 0}):Play()
				end
			end
		end)
	end

	dbs.LMBCombo = true

	play("LMB" .. lmbc)

	local inhb = hb(stand.StandHumanoidRootPart, CFrame.new(0, 0, -4), Vector3.new(5, 5, 6))

	if lmbc > 129449149 then -- // 1 then
		AnimationHandler:Stop({
			["Rig"] = stand,
			["FadeTime"] = 0,
			["Animation"] = anims.LMB[tostring(lmbc - 1)]
		})
	end

	AnimationHandler:Animate({
		["Rig"] = stand,
		["Wrapped"] = true,
		["Priority"] = 2 + (lmbc / 10),
		["Speed"] = (lmbc == 4 and 2 or 1),
		["Animation"] = anims.LMB[tostring(lmbc)]
	})

	if lmbc == 4 then
		lmbc = 1

		coroutine.wrap(function()
			attack(inhb, {
				["Stun"] = .4,
				["Damage"] = 25,
				["HitEffect"] = "Heavy",
				["Sound"] = "HeavyHitSFX",
				["Knockback"] = {75, .3, Vector3.new(0, 35, 0)}
			})
		end)()

		task.delay(AnimationHandler:GetAnimationLength(anims.LMB["4"]) / 2, function()
			if dbs.Summoned == false then
				for _, v in pairs(owner.Character:GetDescendants()) do
					if v.Name == "StandAura" then
						v.Enabled = false
					end
				end

				for _, v in pairs(stand:GetDescendants()) do
					if (v:IsA("BasePart") or v:IsA("Decal") or v:IsA("Texture")) and not v:GetAttribute("Transparency") and v.Name ~= "StandHumanoidRootPart" then
						game:GetService("TweenService"):Create(v, TweenInfo.new(.3), {Transparency = 1}):Play()
					end
				end
			end
		end)

		task.delay(cds.LMBCombo, function()
			dbs.Stunned = false
		end)

		task.delay(cds.LMBFinisher, function()
			dbs.LMBCombo = false
		end)
	else
		play("SwingLMB")
		lmbc += 1

		coroutine.wrap(function()
			attack(inhb, {
				["Stun"] = .75,
				["Damage"] = 8,
				["Knockback"] = {5, .05}
			})
		end)()

		coroutine.wrap(function()
			local clmb = lmbc
			local al = AnimationHandler:GetAnimationLength(anims.LMB[tostring(clmb)])

			task.wait(al)

			if lmbc == clmb then
				if dbs.Summoned == false then
					for _, v in pairs(owner.Character:GetDescendants()) do
						if v.Name == "StandAura" then
							v.Enabled = false
						end
					end

					for _, v in pairs(stand:GetDescendants()) do
						if (v:IsA("BasePart") or v:IsA("Decal") or v:IsA("Texture")) and not v:GetAttribute("Transparency") and v.Name ~= "StandHumanoidRootPart" then
							game:GetService("TweenService"):Create(v, TweenInfo.new(.3), {Transparency = 1}):Play()
						end
					end
				end
			end

			task.wait(1.05 - al)

			if lmbc == clmb then
				lmbc = 1
			end
		end)()

		task.delay(cds.LMBCombo, function()
			dbs.LMBCombo = false
			dbs.Stunned = false
		end)
	end
end

local function bfx(length, stretch, offset)
	local stretch = stretch or 1
	local cf = offset or stand.StandHumanoidRootPart.CFrame

	for _ = 1, 3 do
		local arm
		local p1, p2
		local lt = (cf * CFrame.new(0, 0, -10)).Position

		local function pgen(s)
			local rnd1

			if s == "Right" then
				rnd1 = Random.new():NextNumber(.5, 3) * stretch
			else
				rnd1 = Random.new():NextNumber(-3, -.5) * stretch
			end

			local rnd2 = Random.new():NextNumber(-.5, .5) * stretch

			local rnd3 = math.random()

			local p1 = (cf * CFrame.new(rnd1, rnd2, -2)).Position
			local p2 = (cf * CFrame.new(rnd1 * 2, rnd2 * 6, -4)).Position

			return p1, p2
		end

		if Random.new():NextInteger(1, 10) > 5 then
			local marm = templates.Arms:FindFirstChild("Stand Right Arm")
			arm = marm:Clone()

			p1, p2 = pgen("Right")
		else
			local marm = templates.Arms:FindFirstChild("Stand Left Arm")
			arm = marm:Clone()

			p1, p2 = pgen("Left")
		end

		local tp = Instance.new("Attachment", arm)
		tp.Position = Vector3.new(-.394, .793, .477)

		local bt = Instance.new("Attachment", arm)
		bt.Position = Vector3.new(.329, -.847, -.348)


		local trl = templates["MotionBlur" .. Random.new():NextInteger(1, 2)]:Clone()
		trl.Parent = arm
		trl.Enabled = true
		trl.Attachment0 = tp
		trl.Attachment1 = bt
		trl.Color = ColorSequence.new(arm.Color)
		trl.Transparency = NumberSequence.new(0, 1)

		arm.Trail.Transparency = NumberSequence.new(0, 1)

		local i = 0

		arm.Anchored = true
		arm.Parent = script
		arm.Transparency = 0

		local cnt
		local length = length or .7

		local rate = 1 / length

		coroutine.wrap(function()
			task.wait(.2)

			for _, v in pairs(arm:GetChildren()) do
				if v:IsA("BasePart") then
					game:GetService("TweenService"):Create(v, TweenInfo.new(.2), {Transparency = 1}):Play()
				end
			end

			game:GetService("TweenService"):Create(arm, TweenInfo.new(.2), {Transparency = 1}):Play()

			trl.Enabled = false
			task.wait(.25)

			arm:Destroy()
		end)()

		local function bezier(p1, p2, p3, t)
			return (1 - t) ^ 2 * p1 + 2 * (1 - t) * t * p2 + t ^ 2 * p3
		end

		cnt = game:GetService("RunService").Heartbeat:Connect(function(dt)
			i = i + dt * rate

			if i > 1 then
				cnt:Disconnect()
				i = 1
			end

			if i + dt * rate <= .8 then
				local v = game:GetService("TweenService"):GetValue(i, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out)

				local nv = game:GetService("TweenService"):GetValue(i + dt * rate, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out)

				local p = bezier(p1, p2, lt, v)
				local np = bezier(p1, p2, lt, nv)

				arm.CFrame = CFrame.new(p, np) * CFrame.Angles(math.pi / 2, 0, 0)
			else
				local v = game:GetService("TweenService"):GetValue(i, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out)

				local p = bezier(p1, p2, lt, v)
				arm.CFrame = CFrame.new(p, lt) * CFrame.Angles(math.pi / 2, 0, 0)
			end

			-- // print((arm.Position - owner.Character.HumanoidRootPart.Position).Magnitude)
		end)
	end
end

