		meter.Size = UDim2.fromScale(1, 1)
		tw:Create(meter, TweenInfo.new(.1), {BackgroundTransparency = .75}):Play()
		tw:Create(meter, TweenInfo.new(cds[name], Enum.EasingStyle.Linear), {Size = UDim2.fromScale(0, 1)}):Play()
		task.wait(cds[name])
	end

	dbs[rname] = false
	meter.BackgroundTransparency = 1
end

