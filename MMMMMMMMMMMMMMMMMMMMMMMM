local function play(what, p, scf)
	if sounds[what] then
		local snd = sounds[what]:Clone()
		snd.Name = what
		snd.Parent = p or raga.HumanoidRootPart

		local pt

		if scf ~= nil then
			pt = Instance.new("Part")
			pt.CanCollide = false
			pt.Size = Vector3.one
			pt.Transparency = 1
			pt.CanQuery = false
			pt.CanTouch = false
			pt.Anchored = true
			pt.CFrame = scf

			pt.Parent = script
			snd.Parent = pt
		end

		snd:Play()

		snd.Ended:Once(function()
			task.wait(.1)
			snd:Destroy()

			if pt then
				pt:Destroy()
			end
		end)

		return snd
	end
end

