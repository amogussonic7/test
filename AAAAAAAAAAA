		end
	end
	local function recurse(i,o)
		if table.find(allowed,i) == nil and typeof(i) == 'string' and typeof(o) == 'table' and o.CFrame then
			table.insert(allowed,i)
		end
		if typeof(o) == 'table' then
			for i_,v in pairs(o) do
				recurse(i_,v)
			end
		end
