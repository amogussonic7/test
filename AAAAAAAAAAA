				end
				m.lasttime = i
				if m.canceled then break end
			end
			stopped:Fire()
			m.lasttime = defaultlerp
			if lopa.Looped and not m.canceled then
				playing = false
				m.lasttime = -.02
				m.canceled = false
			else
				enable(false)
			end
		end
	end)
