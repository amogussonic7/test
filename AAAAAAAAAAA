		pcall(function()
			local obj = game:GetObjects(our.AnimationId)[1]
			our = obj
		end)
	end
	if setting or type(our) == 'userdata' and our:IsA'KeyframeSequence' then
		if setting.loadseq and setting.seq or our:IsA'KeyframeSequence' then
			local seq :KeyframeSequence = setting and setting.seq or our
			our = {
				Looped = seq.Loop,
				Keyframes = {},
				Properties = {
					Markers = {}
				}
			}
			local kfs = seq:GetKeyframes()
			table.sort(kfs,function(a,b)
				return a.Time < b.Time
			end)
			local function recurse(v,s,t)
				if v:isA("Pose") then
					s[v.Name] = {
						Style = v.EasingStyle.Name,
						Direction = v.EasingDirection.Name,
						CFrame = v.CFrame
					}
				end
				for i1,v1 in pairs(v:children()) do
					if v1:IsA("KeyframeMarker") then
					    
						our.Properties.Markers[t] = our.Properties.Markers[t] or {}
						our.Properties.Markers[t][v1.Name] = v1.Value
					end
					if v:IsA("Pose") then
						recurse(v1,s[v.Name],t)
					end
				end
			end
			for i,v in pairs(kfs) do
				our.Keyframes[v.Time] = {}
				for I,V in pairs(v:children()) do
					if V:IsA("Pose") then
						recurse(V,our.Keyframes[v.Time],v.Time)
					end
				end
			end
		end
	end
	local tbl = {
		Properties = {
			Looping = false,
		},
		Keyframes = our
	}
	if our.Keyframes == nil and our.Properties == nil then
		our = tbl
	end
