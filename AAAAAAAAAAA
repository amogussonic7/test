				v:Resume()
			end
			m.paused = false
		end,
		SetC0 = function(_,t)
			for i,v in pairs(m.joi) do
				for i_,v_ in pairs(t) do
					if v.Name == v_.Name then
						v.C0 = v_.C0
					end
				end
			end
		end,
		Stop = function()
			for i,v in pairs(m.tweens) do
				v:Destroy()
				m.tweens[i] = nil
			end
			m.canceled = true
			enable(false)
			stopped:Fire()
		end,
		Destroy = function()
			for i,v in pairs(m.tweens) do
