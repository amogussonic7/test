				if v:IsA("Texture") then
					v.Texture = shirt.ShirtTemplate
				end
			end
		end

		coroutine.wrap(function()
			task.wait(1)
			donut.BloodHit.Enabled = false
			
			task.wait(8)
			w:Destroy()
			donut:Destroy()
			torso.Transparency = 0
		end)()
	elseif what == "BloodSplat" then
		for i = 1, 25 do
			if i == 1 then
				for _, v in pairs(organs) do
					local organ = assets[v]:Clone()
					organ.Parent = script
					organ.CanCollide = false
					organ.CFrame = hrp.CFrame * CFrame.Angles(
						math.rad(
							math.random(-45, 45)
						),
						
						math.rad(
							math.random(-45, 45)
						),

						math.rad(
							math.random(-45, 45)
						)
					)

					local bp = Instance.new("BodyPosition", organ)
					bp.D = 800
					bp.MaxForce = Vector3.one * 1000000
					bp.Position = (organ.CFrame * CFrame.new(0, 0, math.random(-7, -5))).Position

					task.delay(.2, function()
						bp:Destroy()
						organ.CanCollide = true
						task.wait(5)

						organ:Destroy()
					end)
				end
			end

			for i = 1, 4 do
				local trail = assets.BloodTrail:Clone()
				trail.Parent = script
				trail.CanCollide = false
				trail.Trail.Lifetime = math.random(1, 5) / 10
				trail.CFrame = hrp.CFrame * CFrame.Angles(
					math.rad(
						math.random(-45, 45)
					),
					
					math.rad(
						math.random(-45, 45)
					),

					math.rad(
						math.random(-45, 45)
					)
				)

				local bp = Instance.new("BodyPosition", trail)
				bp.D = 800
				bp.MaxForce = Vector3.one * 100000000
				bp.Position = (trail.CFrame * CFrame.new(0, math.random(-2, 2), math.random(-13, -5))).Position

				task.delay(.2, function()
					bp:Destroy()
					task.wait(.2)

					local params = RaycastParams.new()
					params.FilterType = Enum.RaycastFilterType.Exclude
					params.FilterDescendantsInstances = {char, script, victim}

					local result = workspace:Raycast(trail.Position, Vector3.new(0, -15, 0), params)

					if result then
						coroutine.wrap(function()
							local pool = assets.Blood:Clone()
							pool.Parent = script
							pool.Material = Enum.Material.Glass
							pool.Position = result.Position + Vector3.new(math.random(-1, 1), 0, math.random(-1, 1))
							
