local function taunt(data)
	local ui

	if not char.Head:FindFirstChild("Taunt") then
		ui = assets.Taunt:Clone()
		ui.Parent = char.Head
	else
		ui = char.Head:FindFirstChild("Taunt")
	end

	ui.Text.Text = ""
	task.wait()
	tween:Create(ui.Text, TweenInfo.new(.5), {TextTransparency = 0}):Play()
	tween:Create(ui.Text, TweenInfo.new(.5), {TextStrokeTransparency = .75}):Play()

	coroutine.wrap(function()
		for i = 1, #(data[1]) do
			task.wait(.03)
			ui.Text.Text = string.sub(data[1], 1, i)

			if data.Timings then
				for part, time in pairs(data.Timings) do
					if string.match(ui.Text.Text, part) and not time[2] then
						time[2] = true
						task.wait(time[1])
					end
				end
			end
		end
	end)()

	play(data[2]).Ended:Wait()
	
	if data.Timings then
		for _, time in pairs(data.Timings) do
			time[2] = false
		end
	end

	task.wait(1.5)
	tween:Create(ui.Text, TweenInfo.new(.5), {TextTransparency = 1}):Play()
	tween:Create(ui.Text, TweenInfo.new(.5), {TextStrokeTransparency = 1}):Play()

	create_cd("Taunt")
