		a1.Parent = clone
		a1.CFrame = CFrame.new(-.625, 0, 0)

		local cl = clone.Color

		for _, v in pairs(a0:GetChildren()) do
			v.Attachment0 = a0
			v.Attachment1 = a1
			v.Color = ColorSequence.new(cl, Color3.new(cl.R * .8, cl.G * .8, cl.B * .8))
		end

		task.wait(.85)
		warm:Destroy()

		local bv = Instance.new("BodyVelocity", ball)
		bv.MaxForce = Vector3.new(1, 1, 1) * 1000000000
		bv.Velocity = hum.RootPart.CFrame.LookVector.Unit * 15 + Vector3.new(0, 25, 0)
		task.delay(.1, bv.Destroy, bv)

		local bp = Instance.new("BodyPosition", ball)
		bp.P = 0
		bp.MaxForce = Vector3.zero
		bp.Position = head.Position
		
		local bav = Instance.new("BodyAngularVelocity", ball)
		bav.P = 0
		bav.AngularVelocity = Vector3.zero
		bav.MaxTorque = Vector3.one * 10000000
		
		task.delay(10, function()
			if clone.Parent then
				clone:Destroy()
			end
		end)

		coroutine.wrap(function()
			local params = RaycastParams.new()
			params.RespectCanCollide = true
			params.FilterDescendantsInstances = {clone}
			params.FilterType = Enum.RaycastFilterType.Exclude

			while true do
				task.wait()

				local result = workspace:Raycast(ball.Position, Vector3.yAxis * -1, params)

				if result then
					task.wait(.1)

					local bf = Instance.new("BodyForce", ball)
					bf.Force = Vector3.yAxis * -10000

					local fx = assets.Other.HeadBombSurface.Attachment:Clone()
					fx.Parent = workspace.Terrain
					fx.Position = result.Position

					for _, v in pairs(fx:GetChildren()) do
						task.delay(v:GetAttribute("EmitDelay") or 0, v.Emit, v, v:GetAttribute("EmitCount") or 15)
					end

					task.delay(2, fx.Destroy, fx)

					break
				end
			end
		end)()

		coroutine.wrap(function()
			task.wait(.5)

			local accel = 5

			while clone.Parent do
				accel *= 1 + (task.wait() * 1.5)

				local dir = CFrame.new(clone.Position, head.Position)
				local dist = (clone.Position - head.Position).Magnitude
				
				if not clone.Anchored and clone.Parent then
					clone:SetNetworkOwner(nil)
				end

				if dist <= 8 then
					ball.CanCollide = false

					bav.P = 0
					bp.P = 50000
					bp.Position = head.Position

					bav.MaxTorque = Vector3.zero
					bp.MaxForce = Vector3.one * 100000000
				else
					ball.CanCollide = true

					bp.P = 0
					bav.P = 1500

					bp.MaxForce = Vector3.zero
					bav.MaxTorque = Vector3.one * 100000000
				end

				bav.AngularVelocity = bav.AngularVelocity:Lerp(
					Vector3.new(
						dir.LookVector.Z,
						dir.LookVector.Y,
						-(dir.LookVector.X)
					)

					* math.clamp(accel, 0, 50),
				.5)

				if dist <= 2 then
					local pos = clone.Position

					local expl = Instance.new("Explosion", script)
					expl.Position = pos
					expl.Visible = false
					expl.BlastRadius = 16
					expl.BlastPressure = 0
					expl.DestroyJointRadiusPercent = 0

					task.delay(2, expl.Destroy, expl)

					local params = RaycastParams.new()
					params.FilterType = Enum.RaycastFilterType.Exclude
					params.FilterDescendantsInstances = {clone, head:FindFirstAncestorOfClass("Model")}

					local cast = workspace:Raycast(pos, Vector3.yAxis * -1024, params)

					if cast then
						pos = cast.Position + Vector3.new(0, .05, 0)
					end

					local fx = assets.Other.Explosion:Clone()
					fx.Parent = script
					fx.Position = pos

					task.delay(5, fx.Destroy, fx)

					for _, v in pairs(fx:GetDescendants()) do
						if v:IsA("ParticleEmitter") then
							v:Emit(15)
						elseif v:IsA("PointLight") then
							v.Brightness = 15

							task.delay(.2, function()
								v.Brightness = 0
							end)
						end
					end

					local hums = {}

					expl.Hit:Connect(function(hit)
						local thum = findhum(hit)

						if thum and thum ~= hum and not hums[thum] then
							hums[thum] = true
							attack({thum.Parent}, statistics.HeadBomb)
							thum.RootPart.AssemblyLinearVelocity = CFrame.new(pos, thum.RootPart.Position).LookVector.Unit * 125
						end 
					end)

					clone:Destroy()

					break
				end
			end
		end)()
	end
end

