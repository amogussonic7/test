local function summon()
	if dbs.Summon or dbs.Stunned or dbs.PoseActive then
		return
	end

	dbs.Summon = true
	dbs.Stunned = true
	dbs.Summoned = not dbs.Summoned

	if dbs.Summoned then
		play("Summon")
		anims.User.Summon:Play(1.5)
		anims.Stand.Summon:Play(1.5)

		for _, v in pairs(char:GetDescendants()) do
			if v.Name == "StandAura" then
				v.Enabled = true
			end
		end

		for _, v in pairs(stand:GetDescendants()) do
			if v:IsA("BasePart") and v.Name ~= "StandHumanoidRootPart" then
				task.delay(.5, function()
					tween:Create(v, TweenInfo.new(.5), {Transparency = 0}):Play()
				end)
			elseif v.Name == "SummonParticle" then
				for _, v2 in pairs(v:GetChildren()) do
					v2:Emit(v2.Name ~= "Stars(125)" and 25 or 125)
				end
			elseif v.Name == "StandAura" then
				v.Enabled = true
			end
		end
		
		anims.Stand.Summon.Stopped:Wait()
		anims.Stand.SIdle:Play()
	else
		play("Unsummon")
		anims.Stand.Run:Stop()
		anims.Stand.SIdle:Stop()

		for _, v in pairs(char:GetDescendants()) do
			if v.Name == "StandAura" then
				v.Enabled = false
			end
		end

		for _, v in pairs(stand:GetDescendants()) do
			if v:IsA("BasePart") and v.Name ~= "StandHumanoidRootPart" then
				tween:Create(v, TweenInfo.new(.1), {Transparency = 1}):Play()
			elseif v.Name == "StandAura" then
				v.Enabled = false
			end
		end

		task.wait(.5)
	end

	dbs.Stunned = false
	create_cd("Summon")	
end

