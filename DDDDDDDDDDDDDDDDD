local function reflect(t, time, dmg)
    local b = assets.Other.LTBeam:Clone()
	b.Parent = script
	b.Bottom.Attachment2.WorldCFrame = hum.RootPart.CFrame * CFrame.new(0, -2, 0)
	b.Bottom.Attachment.WorldCFrame = hum.RootPart.CFrame * CFrame.new(0, -2, 0)
	b:SetPrimaryPartCFrame(CFrame.new(hum.RootPart.Position, t.HumanoidRootPart.Position))
			
	tween:Create(b.Bottom.Attachment2, TweenInfo.new(.6, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {WorldCFrame = t.HumanoidRootPart.CFrame * CFrame.new(0, -2, 0)}):Play()
	tween:Create(b.Bottom.Beam, TweenInfo.new(.6, Enum.EasingStyle.Sine), {Width0 = 0, Width1 = 0}):Play()
			
	for i = 1, (t.HumanoidRootPart.Position - hum.RootPart.Position).Magnitude, 3 do
		local tb = b.LoveTrain:Clone()
		tb.Parent = b
		tb.CFrame = b.Bottom.CFrame * CFrame.new(Vector3.new(0, -2, -(i))) * CFrame.Angles(math.pi / 2, 0, 0)
	end
	
	for _, v in pairs(b:GetDescendants()) do
		if v:IsA("Beam") and v.Parent.Name ~= "Bottom"  then
			coroutine.wrap(function()
				local dist = (v.Parent.Position - hum.RootPart.Position).Magnitude
				task.wait(dist / 200)

				local at1 = v.Attachment1
				tween:Create(at1, TweenInfo.new(.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Position = Vector3.new(0, 0, -1* Random.new():NextNumber(.5, 3))}):Play()
				task.wait(dist / 150)

				tween:Create(at1, TweenInfo.new(.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Position = Vector3.new()}):Play()
			end)()
		end
	end

	coroutine.wrap(function()
		task.wait(3)
		b:Destroy()
	end)()

