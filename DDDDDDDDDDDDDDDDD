local function play(what, p, scf)
	if sounds[what] then
		local snd = sounds[what]:Clone()
		snd.Name = what
		snd.Parent = p or hum.RootPart

		local pt

		if scf ~= nil then
			pt = Instance.new("Part", script)
			pt.CFrame = scf
			pt.CanCollide = false
			pt.CanQuery = false
			pt.CanTouch = false
			pt.Anchored = true
			pt.Transparency = 1
			pt.Size = Vector3.one

			snd.Parent = pt
		end

		snd:Play()
		
		coroutine.wrap(function()
			snd.Ended:Wait()
			task.wait(.1)

			snd:Destroy()

			if pt then
				pt:Destroy()
			end
		end)()

		return snd
	end
end

