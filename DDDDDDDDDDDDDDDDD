		arm.Transparency = 1

		local carm = assets.Other.HalfLeftArm:Clone()
		carm:PivotTo(arm.CFrame)

		carm.Parent = victim
		carm.Top.TopArm.Color = arm.Color
		carm.Bottom.BottomArm.Color = arm.Color

		if shirt then
			carm.Top.Shirt.TextureID = shirt.ShirtTemplate
			carm.Bottom.Shirt.TextureID = shirt.ShirtTemplate
		else
			carm.Top.Shirt:Destroy()
			carm.Bottom.Shirt:Destroy()
		end
		
		local w = Instance.new("Weld", carm.Top.TopArm)
		w.Part0 = arm
		w.Part1 = carm.Top.TopArm
		w.C0 = CFrame.new(0, .35, 0)

		for _, v in pairs(carm:GetDescendants()) do
			if v:IsA("ParticleEmitter") then
				v.Enabled = true
			end
		end

		coroutine.wrap(function()
			local start = tick()

			repeat
				task.wait(.75)

				if carm.Parent ~= nil and #(carm:GetDescendants()) > 3 and carm:FindFirstChild("Bottom") then
					local params = RaycastParams.new()
					params.FilterType = Enum.RaycastFilterType.Exclude
					params.FilterDescendantsInstances = {char, script, victim}

					local result = workspace:Raycast(carm.Bottom.BottomArm.Position, Vector3.new(0, -15, 0))

					if result then
						coroutine.wrap(function()
							local pool = assets.Blood:Clone()
							pool.Parent = script
							pool.Material = Enum.Material.Glass
							pool.Position = result.Position + Vector3.new(math.random(-1, 1), 0, math.random(-1, 1))
							
							tween:Create(pool, TweenInfo.new(.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = pool.Size * math.random(2, 5)}):Play()
							task.wait(5)
							
							tween:Create(pool, TweenInfo.new(.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Transparency = 1}):Play()
							task.wait(.5)
							pool:Destroy()
						end)()
					end
