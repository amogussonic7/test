local function gore(victim, what)
	local torso = victim:FindFirstChild("Torso")
	local arm = victim:FindFirstChild("Left Arm")
	local shirt = victim:FindFirstChildWhichIsA("Shirt")
	local hrp = victim:FindFirstChild("HumanoidRootPart")

