local function fire(cf, stats)
	local bullet = assets.Other.RevolverBullet:Clone()
	bullet.Parent = script
	bullet.Anchored = true
	bullet.CFrame = cf * CFrame.Angles(math.pi / 2, 0, 0)
	
	coroutine.wrap(function()
		while (bullet.Position - cf.Position).Magnitude <= 250 do
			local dist = cf.lookVector * 2
			local tdist = (dist * 2) * (task.wait() * 60)

			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			params.FilterDescendantsInstances = {char, script}
			
			local ray = workspace:Raycast(bullet.CFrame.Position, tdist, params)

			if ray then
				local hum = findhum(ray.Instance)

				if hum then
					attack({hum:FindFirstAncestorOfClass("Model")}, stats)
					bullet:Destroy()

					break
				else
					local pc = assets.ProjectileCollision:Clone()
					pc.Parent = script
					pc.DashParticle:Emit(30)
					pc.DashParticle.Enabled = false
					pc.DashParticle.Color = ColorSequence.new(ray.Instance.Color)
					pc.CFrame = CFrame.new(ray.Position, ray.Position + ray.Normal)

					task.delay(3, pc.Destroy, pc) 
					play("Collision", pc).RollOffMaxDistance = 60

					bullet:Destroy()

					break
				end
			end

			bullet.CFrame += tdist
		end

		bullet:Destroy()
	end)()
end

