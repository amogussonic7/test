connection = game:GetService("RunService").PostSimulation:Connect(function()
	if not character or not character.Parent then return end

	if humanoid.Health <= 0 or character.Parent == nil then
		connection:Disconnect()
	end
	if  character:FindFirstChild("Stunned") or character:GetAttribute("Stunned") then
		return
	end

	if character:FindFirstChild("RagdollTime") or character:GetAttribute("Ragdolled") then
		walk:Stop()
		run:Stop()
		fall:Stop()
		idle:Stop()		
	end

	if stuffs.Busy.Stunned or stuffs.Busy.Ragdolled then
		return
	end

	if stuffs.Settings.General.CanRotate == false then
		humanoid.AutoRotate = false
	else
		humanoid.AutoRotate = true
	end

	if not stuffs.Settings.General.CanMove then
		humanoid.WalkSpeed = 0
	else
		if running then
			humanoid.WalkSpeed = stuffs.Settings.Character.RunSpeed * stuffs.Settings.General.TimeScale
		else
			humanoid.WalkSpeed = stuffs.Settings.Character.Speed * stuffs.Settings.General.TimeScale
		end
		if stuffs.Settings.Combat.Stance == "Crouch" then
			humanoid.WalkSpeed = 0
			crouch:AdjustWeight(0.999)
		else
			crouch:AdjustWeight(0)
		end
		if stuffs.Settings.Combat.Stance == "Blocking" then
			humanoid.WalkSpeed = 0
			block:AdjustWeight(0.999)
		else
			block:AdjustWeight(0)
		end
	end

	if state ~= currentState then
		currentState = state

		if state == "Idle" then
			idle:AdjustWeight(0.99)
			walk:AdjustWeight(0)
			run:AdjustWeight(0)
			fall:AdjustWeight(0)

		elseif state == "Walking" then
			idle:AdjustWeight(0)
			walk:AdjustWeight(0.99)
			run:AdjustWeight(0)
			fall:AdjustWeight(0)

		elseif state == "Running" then
			idle:AdjustWeight(0)
			walk:AdjustWeight(0)
			run:AdjustWeight(0.99)
			fall:AdjustWeight(0)

		elseif state == "Falling" then
			print("IM FALLING")
			idle:AdjustWeight(0)
			walk:AdjustWeight(0)
			run:AdjustWeight(0)
			fall:AdjustWeight(0.999)
		end
	end
end)
