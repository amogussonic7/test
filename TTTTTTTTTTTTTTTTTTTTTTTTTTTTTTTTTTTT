local function mag_check(origin, radius, filters, callback, ...)
	filters = filters or {}
	local results = {}

	for _, plr in game:GetService("Players"):GetPlayers() do
		local char = plr.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")

		if not hrp then
			continue
		end

		if filters.aliveOnly and (not hum or hum.Health <= 0) then
			continue
		end

		if filters.team and plr.Team ~= filters.team then
			continue
		end

		if filters.ignore and table.find(filters.ignore, plr) then
			continue
		end

		local offset = hrp.Position - origin
		if not stuffs.Framework.Functions.MagnitudeCheck(offset, radius) then
			continue
		end

		if filters.custom and not filters.custom(plr) then
			continue
		end

		table.insert(results, plr)
		if callback then
			task.spawn(function(...)
				callback(plr, ...)
			end)
		end

		if filters.max and #results >= filters.max then
			break
		end
	end

	return results
end

