local active_movers = {}

local function dash(root, range, duration, mode)
	if not root or not root.Parent then return end
	mode = mode or "locked"

	local character = root.Parent
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end

	if active_movers[root] then
		active_movers[root]:Disconnect()
		active_movers[root] = nil
	end

	local startTime = time()

	local dashDirection
	if mode == "locked" then
		dashDirection = root.CFrame.LookVector
	end

	active_movers[root] = game:GetService("RunService").Heartbeat:Connect(function()
		if not root.Parent then
			active_movers[root]:Disconnect()
			active_movers[root] = nil
			return
		end

		local elapsed = time() - startTime
		local t = math.clamp(elapsed / duration, 0, 1)
		local factor = 1 - t

		local direction = (mode == "locked" and dashDirection) or root.CFrame.LookVector

		local velocity = direction * range * factor

		root.AssemblyLinearVelocity = Vector3.new(
			velocity.X,
			velocity.Y,--root.AssemblyLinearVelocity.Y,
			velocity.Z
		)

		if t >= 1 then
			active_movers[root]:Disconnect()
			active_movers[root] = nil
		end
	end)
end
local function find(part: BasePart)
	local model = part:FindFirstAncestorOfClass("Model")
	return model and model:FindFirstChildOfClass("Humanoid") or nil
end

local function get_nearby(position: Vector3, radius: number)
	local humanoids = {}
	local seen = {}

	for _, part in workspace:GetPartBoundsInRadius(position, radius) do
		local humanoid = find(part)
		if humanoid and not seen[humanoid] then
			seen[humanoid] = true
			table.insert(humanoids, humanoid.Parent)
		end
	end

	return humanoids
end
local function dash2(host: BasePart, distance: number?, target: BasePart?, ignore: boolean?, timer: number?, complete: any?)
	distance = distance or 80
	timer = timer or 0.2

	if not host then return end
	local hrp = target or host

	local starting = host.Position
	local direction = (hrp.CFrame.LookVector).Unit
	local original_direction = direction
	local reach = hrp.Position + direction * distance
	local achieve = CFrame.new(reach, reach + direction)

	local rayc = RaycastParams.new()
	rayc.FilterType = Enum.RaycastFilterType.Exclude

	local exclude = {
		host.Parent,
		script,
		--workspace:FindFirstChild("Map")
	}

	if ignore then
		for _, model in get_nearby(hrp.Position, 150) do table.insert(exclude, model) end
		for _, model in get_nearby(reach, 150) do table.insert(exclude, model) end
	end

	rayc.FilterDescendantsInstances = exclude

	local ray = workspace:Raycast(hrp.Position, direction * distance, rayc)
	if ray then
		reach = ray.Position
		achieve = CFrame.new(reach, reach + direction)
	end

	local speed = distance / timer

	task.spawn(function()
		local start = tick()
		local duration = timer
		local current = starting

		while true do
			local now = tick()
			local elapsed = now - start

			if elapsed >= duration then
				host.CFrame = achieve
				if complete then complete(reach, original_direction) end
				break
			end

			local dt = game:GetService("RunService").Heartbeat:Wait()

			local move = original_direction * speed * dt
			local willyou = current + move

			local finish = reach - current
			local areyou = finish.Magnitude

			if move.Magnitude >= areyou then
				current = reach
				host.CFrame = CFrame.new(reach, reach + original_direction)
				if complete then complete(reach, original_direction) end
				break
			else
				current = willyou
				host.CFrame = CFrame.new(current, current + original_direction)
			end
		end
	end)
end

