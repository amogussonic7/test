				["CameraShake"] = function(args)
					local RunService = game:GetService("RunService")
					local workspace = workspace

					local intensity = (args and args.Intensity) or 1
					local duration = (args and args.Duration) or 0.35
					local frequency = (args and args.Frequency) or 16
					local rotIntensity = (args and args.RotationIntensity) or (math.clamp(intensity * 0.5, 0, 2))
					local falloff = (args and args.Falloff) or "linear"
					local onComplete = (args and args.OnComplete)

					if duration <= 0 or intensity <= 0 then
						if onComplete then pcall(onComplete) end
						return
					end

					local cam = workspace.CurrentCamera
					if not cam then
						if onComplete then pcall(onComplete) end
						return
					end

					local startTime = tick()
					local rnd = Random.new()
					local sx, sy, sz, srx, sry, srz = rnd:NextNumber(), rnd:NextNumber(), rnd:NextNumber(), rnd:NextNumber(), rnd:NextNumber(), rnd:NextNumber()

					local lastShake = CFrame.new()
					local conn

					local function computeDecay(t)
						local p = 1 - (t / duration)
						if p < 0 then p = 0 end
						if falloff == "exponential" then
							return p * p
						else -- linear
							return p
						end
					end

					conn = RunService.RenderStepped:Connect(function()
						local elapsed = tick() - startTime
						if elapsed >= duration then
							if lastShake then
								local ok, _ = pcall(function()
									cam.CFrame = cam.CFrame * lastShake:Inverse()
								end)
							end
							conn:Disconnect()
							if onComplete then pcall(onComplete) end
							return
						end

						if lastShake then
							local ok, _ = pcall(function()
								cam.CFrame = cam.CFrame * lastShake:Inverse()
							end)
							if not ok then
								conn:Disconnect()
								if onComplete then pcall(onComplete) end
								return
							end
						end

						local t = elapsed * frequency
						local nx = (math.noise(sx, t) - 0.5) * 2
						local ny = (math.noise(sy, t + 30) - 0.5) * 2
						local nz = (math.noise(sz, t + 60) - 0.5) * 2

						local nrx = (math.noise(srx, t + 90) - 0.5) * 2
						local nry = (math.noise(sry, t + 120) - 0.5) * 2
						local nrz = (math.noise(srz, t + 150) - 0.5) * 2

						local decay = computeDecay(elapsed)

						local posShake = Vector3.new(nx, ny * 0.7, nz) * intensity * decay
						local rotShake = Vector3.new(nrx, nry, nrz) * rotIntensity * decay

						local newShake = CFrame.new(posShake) * CFrame.Angles(rotShake.X, rotShake.Y, rotShake.Z)

						local ok, _ = pcall(function()
							cam.CFrame = cam.CFrame * newShake
						end)
						if not ok then
							conn:Disconnect()
							if onComplete then pcall(onComplete) end
							return
						end

						lastShake = newShake

						pcall(function()
							cam:SetAttribute("shakeCF", newShake)
						end)
					end)
				end,
				
				["VFX"] = function(args)
					local vfx = args.VFX
					local functionType = args.FunctionType
					local emit = args.Emit
					local parent = args.Parent or vfx.Parent
