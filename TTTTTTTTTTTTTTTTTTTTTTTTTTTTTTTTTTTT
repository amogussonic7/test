local SlashTrail = (function()
	local RunService = (game:FindService("RunService") or game:GetService("RunService"));
	local Debris = (game:FindService("Debris") or game:GetService("Debris"));

	-- VARIABLES

	local Slash_Trail;

	local Slash_Model = Instance.new("Model");


	-- FUNCTIONS

	Slash_Trail = function(Part, Slash_Size, Slash_Width, Slash_Color, Duration, Offset, Pitch_Start, Pitch_End)

		assert(Part, "No part to base rotation around.");

		Offset = Offset or CFrame.new(0, 0, 0);

		local Slash = Slash_Model:Clone();
		Debris:AddItem(Slash, Duration + 1);

		local Slash_1 = Slash["1"];
		local Slash_2 = Slash["2"];

		Slash_1.CFrame = Part.CFrame * Offset * CFrame.fromOrientation(0, Pitch_Start, 0);
		Slash_2.CFrame = Part.CFrame * Offset * CFrame.fromOrientation(0, Pitch_Start, 0);

		do
			local Mesh = Slash_1.Trail_Mesh;
			local Decal = Slash_1.Slash_Decal;

			Decal.Color3 = Slash_Color;
			Mesh.Scale = Vector3.new(Slash_Size, Slash_Width, Slash_Size);

			Mesh = Slash_2.Trail_Mesh;
			Decal = Slash_2.Slash_Decal;

			Decal.Color3 = Slash_Color;
			Mesh.Scale = Vector3.new(Slash_Size, -Slash_Width, Slash_Size);
		end

		Slash.Parent = (RunService:IsClient() and workspace.CurrentCamera) or workspace;

		local current_duration = 0;

		--print("SLASH TRAIL");

		while current_duration < Duration do

			local Alpha = math.clamp(current_duration / Duration, 0, 1);

			local Angle = Vector2.new(Pitch_Start, Pitch_Start):Lerp(Vector2.new(Pitch_End, Pitch_End), Alpha).X

			Slash_1.CFrame = Part.CFrame * Offset * CFrame.fromOrientation(0, Angle, 0);
