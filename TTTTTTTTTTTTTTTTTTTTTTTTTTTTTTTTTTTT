	["LockOn"] = function(parent)
		local cr_source = [=[
			local Players = game:GetService("Players")
			local UIS = game:GetService("UserInputService")
			local RunService = game:GetService("RunService")

			local PLR = Players.LocalPlayer
			local CC = workspace.CurrentCamera
			local Char = PLR.Character or PLR.CharacterAdded:Wait()

			local Config = {
				smoothing = 0.13,
				positionSmoothing = 0.22,
				lookAtSmoothing = 0.28,

				Modes = {
					["2D"] = {
						sideDistance = 18,
						heightFactor = 0.35,
						heightClamp = {min = 6, max = 18},
						axisYawSpeed = 12,
					},
					["Topdown"] = {
						heightFactor = 1.2,
						heightClamp = {min = 25, max = 70},
						tiltDegrees = 12,
					},
					["Side"] = {
						forwardOffsetBase = 8,
						forwardOffsetScale = 0.25,
						upOffsetBase = 3,
						upOffsetScale = 0.05,
						sideOffset = 4,
					},
				},

				maxTargetDistance = 200,
			}

			local Target = nil
			local LastTarget = nil
			local LockOnModes = {"2D", "Topdown", "Side"}
			local currentModeIndex = 1

			local camCF = CC.CFrame
			local camPos = camCF.Position
			local camLook = camPos + camCF.LookVector * 10

			CC:SetAttribute("shakeCF", CFrame.new())

			local function alpha(s, dt)
				return 1 - math.pow(1 - s, dt * 60)
			end

			local function IsCharacter(model)
				if not model or model == Char then return false end
				if not model:IsA("Model") then return false end
				local hum = model:FindFirstChildOfClass("Humanoid")
				local hrp = model:FindFirstChild("HumanoidRootPart")
				return hum and hrp and hum.Health > 0
			end

			local function IsStunned()
				return Char and (Char:FindFirstChild("Stunned") or Char:GetAttribute("Stunned"))
			end

			local function GetTarget()
				local hrp = Char:FindFirstChild("HumanoidRootPart")
				if not hrp then return nil end

				local best, bestScore = nil, math.huge
				for _, m in ipairs(workspace:GetDescendants()) do
					if IsCharacter(m) then
						local r = m:FindFirstChild("HumanoidRootPart")
						if r then
							local d = (hrp.Position - r.Position).Magnitude
							if d < Config.maxTargetDistance then
								local dir = (r.Position - hrp.Position).Unit
								local dot = dir:Dot(hrp.CFrame.LookVector)
								local score = d - (dot * 35)
								if score < bestScore then
									bestScore = score
									best = m
								end
							end
						end
					end
				end
				return best
			end

			local function ClearLock()
				Target = nil
				LastTarget = nil
				CC.CameraType = Enum.CameraType.Custom
			end

			local function OnCharacterAdded(character)
				Char = character
				local hum = Char:FindFirstChildOfClass("Humanoid") or Char:WaitForChild("Humanoid", 5)
				if hum then
					hum.Died:Connect(function()
						ClearLock()
					end)
				end
			end

			if PLR.Character then
				OnCharacterAdded(PLR.Character)
			end
			PLR.CharacterAdded:Connect(OnCharacterAdded)

			UIS.InputBegan:Connect(function(i, gp)
				if gp then return end

				local function playerAlive()
					local hum = Char and Char:FindFirstChildOfClass("Humanoid")
					return hum and hum.Health > 0
				end

				if i.KeyCode == Enum.KeyCode.L or i.UserInputType == Enum.UserInputType.MouseButton3 then
					if not playerAlive() then return end

					if Target then
						ClearLock()
					else
						Target = GetTarget()
						LastTarget = Target
					end
				end

				if i.KeyCode == Enum.KeyCode.C then
					if playerAlive() then
						Target = LastTarget
					end
				end

				if i.KeyCode == Enum.KeyCode.V then
					currentModeIndex = currentModeIndex + 1
					if currentModeIndex > #LockOnModes then
						currentModeIndex = 1
					end
				end
			end)

			RunService.RenderStepped:Connect(function(dt)
				Char = PLR.Character
				if not Char then return end

				local root = Char:FindFirstChild("HumanoidRootPart")
				if not root then return end

				if not Target or not Target.Parent then
					CC.CameraType = Enum.CameraType.Custom
					return
				end

				local enemyRoot = Target:FindFirstChild("HumanoidRootPart")
				if not enemyRoot then return end

				CC.CameraType = Enum.CameraType.Scriptable

				local rootPos = root.Position
				local enemyPos = enemyRoot.Position
				local midpoint = (rootPos + enemyPos) * 0.5
				local dist = (rootPos - enemyPos).Magnitude
				local mode = LockOnModes[currentModeIndex]

				local targetCamPos
				local targetLookAt

				if mode == "2D" then
					local dir = (enemyPos - rootPos).Unit
					local side = Vector3.new(-dir.Z, 0, dir.X)

					local h = math.clamp(dist * Config.Modes["2D"].heightFactor,
						Config.Modes["2D"].heightClamp.min,
						Config.Modes["2D"].heightClamp.max)

					targetCamPos = midpoint + side * Config.Modes["2D"].sideDistance + Vector3.new(0, h, 0)
					targetLookAt = midpoint

					if not IsStunned() then
						local lookAt = Vector3.new(enemyPos.X, rootPos.Y, enemyPos.Z)
						root.CFrame = CFrame.new(rootPos, lookAt)
					end

				elseif mode == "Topdown" then
					local h = math.clamp(dist * Config.Modes["Topdown"].heightFactor,
						Config.Modes["Topdown"].heightClamp.min,
						Config.Modes["Topdown"].heightClamp.max)

					targetCamPos = midpoint + Vector3.new(0, h, 0)

					local forward = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z).Unit
					targetLookAt = midpoint + forward * 8

				else
					local dir = (enemyPos - rootPos)
					local horiz = Vector3.new(dir.X, 0, dir.Z).Unit
					local back = -horiz
					local right = Vector3.new(back.Z, 0, -back.X)

					local cfg = Config.Modes["Side"]

					targetCamPos =
						rootPos
						+ back * (cfg.forwardOffsetBase + dist * cfg.forwardOffsetScale)
						+ right * cfg.sideOffset
						+ Vector3.new(0, cfg.upOffsetBase + dist * cfg.upOffsetScale)

					targetLookAt = enemyPos + Vector3.new(0, 2, 0)
				end

				camPos = camPos:Lerp(targetCamPos, alpha(Config.positionSmoothing, dt))
				camLook = camLook:Lerp(targetLookAt, alpha(Config.lookAtSmoothing, dt))

				CC.CFrame = CFrame.new(camPos, camLook) * (CC:GetAttribute("shakeCF") or CFrame.new())

				if mode ~= "2D" and not IsStunned() then
					local look = Vector3.new(enemyPos.X, rootPos.Y, enemyPos.Z)
					root.CFrame = CFrame.new(rootPos, look)
				end
			end)

		]=]
		stuffs.Framework.Functions.ENV({
			Type = "NLS",
			Name = "LOCKON",
			Source = cr_source,
			Parent = parent,
		})
	end,
	["GeneralReplication"] = function(parent)
		local cr_source = [=[
			local Players = game:GetService("Players")
			local TweenService = game:GetService("TweenService")
			local ReplicatedStorage = game:GetService("ReplicatedStorage")
			local RunService = game:GetService("RunService")

			local plr = Players.LocalPlayer
			local cam = workspace.CurrentCamera
			local remote = ReplicatedStorage:WaitForChild("ReplicatorRemote", 10)
			local actions = {}
			actions = {
				
				["BodyVelocity"] = function(args)
					local part = args[1]
					local speed = args[2]
					local mode = args[3]

					if not part or not speed then return end

					local bv = Instance.new("BodyVelocity")
					bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
					bv.Parent = part

					if mode == "Look" then
						local connection
						connection = RunService.Heartbeat:Connect(function()
							if not part or not part.Parent then
								connection:Disconnect()
								return
							end

							bv.Velocity = part.CFrame.LookVector * speed
						end)
					else
						bv.Velocity = speed
					end
				end,


				["SetCamera"] = function(args)
					local camType = args[1]
					if camType then
						if typeof(camType) == "EnumItem" then
							cam.CameraType = camType
						else
							if type(camType) == "string" then
								local ok, enumVal = pcall(function() return Enum.CameraType[camType] end)
								if ok and enumVal then
									cam.CameraType = enumVal
								else
									warn("SetCamera: invalid camera type string '" .. tostring(camType) .. "'")
								end
							else
								warn("SetCamera: unsupported camera type: " .. tostring(camType))
							end
						end
					end
				end,
				
				["Cutscene"] = function(args)
					local FocalPoint = args.FocalPoint
					local FPS = args.FPS or 60
					local CutsceneFolder = args.CutsceneFolder
					local CameraOffset = args.CameraOffset or CFrame.new()
					local NormalizeOnEnd = args.NormalizeOnEnd

					if not FocalPoint then return warn("Cutscene: Missing FocalPoint") end
					if not CutsceneFolder then return warn("Cutscene: Missing CutsceneFolder") end

					local FrameFolder = CutsceneFolder:FindFirstChild("Frames")
					local FOVFolder = CutsceneFolder:FindFirstChild("FOV")

					if not FrameFolder or not FOVFolder then
						return warn("Cutscene: Missing Frames or FOV folder")
					end

					cam.CameraType = Enum.CameraType.Scriptable
					local frames = FrameFolder:GetChildren()
					local fovs = FOVFolder:GetChildren()

					table.sort(frames, function(a,b)
						return tonumber(a.Name) < tonumber(b.Name)
					end)
					table.sort(fovs, function(a,b)
						return tonumber(a.Name) < tonumber(b.Name)
					end)
					print("FOCAL:", args.FocalPoint:GetFullName())

					for i = 1, #frames do
						local frameValue = frames[i]:FindFirstChild("Value") or frames[i]
						local fovValue = fovs[i]

						if frameValue and frameValue.Value and fovValue and fovValue.Value then
							cam.CFrame = FocalPoint.CFrame * CameraOffset * frameValue.Value
							cam.FieldOfView = fovValue.Value
						else
							warn("Cutscene: Missing Value in frame or FOV index " .. tostring(i))
						end

						task.wait(1 / FPS)
					end

					if NormalizeOnEnd then
						cam.CameraType = Enum.CameraType.Custom
						cam.CFrame = FocalPoint.CFrame
						cam.FieldOfView = 70
					end
				end,
				
				["Conditional"] = function(args)
					if not args.Humanoid or not args.Root then
						return false
					end

					local hum = args.Humanoid
					local root = args.Root
					local moveMag = hum.MoveDirection.Magnitude
					local grounded = hum.FloorMaterial ~= Enum.Material.Air
					local state = hum:GetState()

					local cond = args.Condition
					if not cond then return false end

					local dir = hum.MoveDirection
					local look = root.CFrame.LookVector
					local right = root.CFrame.RightVector

					local conditions = {
						InAir = not grounded,
						Moving = moveMag > 0,
						Jumped = state == Enum.HumanoidStateType.Jumping,
						Landed = state == Enum.HumanoidStateType.Landed,
						Running = state == Enum.HumanoidStateType.Running,
						Swimming = state == Enum.HumanoidStateType.Swimming,
						Climbing = state == Enum.HumanoidStateType.Climbing,
						GettingUp = state == Enum.HumanoidStateType.GettingUp,
						Dead = state == Enum.HumanoidStateType.Dead,
						PlatformStanding = state == Enum.HumanoidStateType.PlatformStanding,
						FallingDown = state == Enum.HumanoidStateType.FallingDown,
						Falling = state == Enum.HumanoidStateType.Freefall,
						OnGround = grounded,
						Still = moveMag == 0,
						LockedOn = typeof(hum:GetAttribute("LockedTarget")) == "string",
						Forward = dir:Dot(look) > 0.5 and not not grounded,
						Backward = dir:Dot(look) < -0.5 and not not grounded,
						Right = dir:Dot(right) > 0.5 and not not grounded,
						Left = dir:Dot(right) < -0.5 and not not grounded,

						ActuallyMoving = grounded
							and not hum.PlatformStand
							and not root.Anchored
							and Vector3.new(root.Velocity.X, 0, root.Velocity.Z).Magnitude > 0.1
					}

					if cond:find("|") then
						for sub in cond:gmatch("[^|]+") do
							if not conditions[sub] then
								return false
							end
						end
						return true
					elseif cond:find("/") then
						for sub in cond:gmatch("[^/]+") do
							if conditions[sub] then
								return true
							end
						end
						return false
					else
						return conditions[cond] or false
					end
				end,
				
				["FOV"] = function(args)
					local fov = args.FOV
					local time = args.Time
					local fovCancel = args.CancelPrevious
					if not fov or not time then return end

					local tween = TweenService:Create(
						cam,
						TweenInfo.new(time, args.Easing or Enum.EasingStyle.Linear, args.EasingDirection or Enum.EasingDirection.Out),
						{ FieldOfView = fov }
					)

					tween:Play()
					if args.CancelPrevious then
						if fovCancel then fovCancel:Disconnect() end
						tween:Cancel()
					end
				end,
				
				["DisableState"] = function(args)
