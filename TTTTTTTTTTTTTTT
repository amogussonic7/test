bind({
	Key = Enum.KeyCode.Z,
	Character = morph,
	Press = function(player)
		task.spawn(function()
			client_fx(30, jumpscare_ui, 0.2)
			local head = morph:FindFirstChild("Head")
			if not head then return end
			local snd = head:FindFirstChild("Notice")
			if snd and snd.Play then
				snd:Play()
			end
		end)
	end,
})

bind({
	Key = Enum.KeyCode.X,
	Character = morph,
	Press = function(player)
		task.spawn(function()
			if chase then
				chase = false
				chase_aud:Stop()
			else
				chase = true
				chase_aud:Play()
			end
		end)
	end,
})

bind({
	Key = Enum.KeyCode.F,
	Character = morph,
	Press = function(player)
		task.spawn(function()
			invis = not invis

			for _, v in ipairs(morph:GetDescendants()) do
				if v:IsA("MeshPart") then
					v.Transparency = invis and 1 or 0
					if v:FindFirstChildOfClass("SpecialMesh") then
						v.Transparency = invis and 1 or 0
					end
				elseif v:IsA("Decal") then
					v.Transparency = invis and 1 or 0
				elseif v:IsA("PointLight") then
					v.Brightness = invis and 0 or 1
				end
			end
		end)
	end,
})

if root then
	root.Touched:Connect(function(vic)
		if vic:IsDescendantOf(morph) then return end
		local victim_character = vic:FindFirstAncestorOfClass("Model")
		local victim_humanoid = victim_character and victim_character:FindFirstChildOfClass("Humanoid")
		if not victim_humanoid then return end
		victim_character:BreakJoints()
		local victim_player = game:GetService("Players"):GetPlayerFromCharacter(victim_character)
		if victim_player then
			die(victim_player)
		end
	end)
end

task.spawn(function()
	while true do
		task.wait(0.2)
		if humanoid then
			local blacklist = {
