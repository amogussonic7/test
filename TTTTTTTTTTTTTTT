				"Ragdoll",
				"GettingUp",
				"PlatformStanding"
			}
			for _, v in pairs(blacklist) do
				local ok, enumState = pcall(function() return Enum.HumanoidStateType[v] end)
				if ok and enumState then
					humanoid:SetStateEnabled(enumState, false)
				end
			end
		end
	end
end)
