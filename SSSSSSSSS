function RadiusKnockback(part,fromaprt,power,ti)
	local bv = Instance.new("BodyVelocity")
	bv.Parent = part
	bv.Velocity = ((CFrame.new(part.Position,fromaprt.Position).LookVector*Vector3.new(1,0,1))*-power)+Vector3.new(0,30,0)
	bv.MaxForce =Vector3.new(1,1,1)*math.huge
	game:GetService("Debris"):AddItem(bv,ti)
end

function CreateKillTag(hum,obj)
	local t = Instance.new("ObjectValue")
	t.Name = "owner"
	t.Value = obj
	t.Parent = hum
	game:GetService("Debris"):AddItem(t,2)
end

function CreateRagdollTag(hum,tim)
	if hum:FindFirstChild("StunTime") then
		hum:FindFirstChild("StunTime").Value = hum:FindFirstChild("StunTime").Value + tim/2
		return
	end
	local removes = {}
	hum.BreakJointsOnDeath = false
	for i,v in pairs(hum.Parent:GetDescendants()) do
		if (v:isA("Motor6D") or v:isA("Motor")) and v.Name ~= "RootJoint" and v.Name ~= "Root Hip" then
			local a1,a2 = Instance.new("Attachment"),Instance.new("Attachment")
			a1.Parent = v.Part0
			a1.CFrame = v.C0
			a2.Parent = v.Part1
			a2.CFrame = v.C1
			local bsc = Instance.new("BallSocketConstraint")
			bsc.Parent = hum.Parent
			bsc.Attachment0 = a1
			bsc.Attachment1 = a2
			table.insert(removes,bsc)
			v.Enabled = false
		end
		if v:isA("BasePart") then
			if (v.Name:find("Arm") or v.Name:find("Head") or v.Name:find("Leg") or v.Name:find("Foot") or v.Name:find("Hand")) and not v.Name:find("Upper") and  not v.Name:find("Lower") then
				local hit = Instance.new("SpawnLocation")
				hit.Enabled = false
				hit.Size = Vector3.new(.5,.5,.5)
				local w = Instance.new("Weld")
				w.Parent = hit
				hit.Transparency = 1
				hit.Shape = Enum.PartType.Ball
				hit.Parent = v
				w.Part0 = v
				w.Part1 = hit
				if v.Name:find("Arm") or v.Name:find("Leg") then
					w.C0 = CFrame.new(0,-.5,0)
				end
				game:GetService("PhysicsService"):SetPartCollisionGroup(v,"RagdollLimb")
				table.insert(removes,hit)
			end
		end
	end
	local t = Instance.new("NumberValue")
	t.Parent = hum
	t.Value = tim
	t.Name = "StunTime"
	task.spawn(function()
		while t.Value > 0 and t:IsDescendantOf(hum) and t:IsDescendantOf(game) do
			task.wait()
			hum.PlatformStand = true
			if hum.RootPart and hum.RootPart.Velocity.Magnitude <= .2 then
				t.Value = t.Value - .1
			end
		end
		t:Destroy()
		if hum.Health > 0 then
			hum.BreakJointsOnDeath = true
			hum.PlatformStand = false
			for i,v in pairs(removes) do
				v:Destroy()
			end
			for i,v in pairs(hum.Parent:GetDescendants()) do
				if v:isA("JointInstance") then
					v.Enabled = true
				end
				if v:isA("BasePart") then
					if (v.Name:find("Arm") or v.Name:find("Head") or v.Name:find("Leg") or v.Name:find("Foot") or v.Name:find("Hand")) and not v.Name:find("Upper") or  not v.Name:find("Lower") then
						game:GetService("PhysicsService"):SetPartCollisionGroup(v,"Default")
					end
				end
			end
		end
	end)
end
