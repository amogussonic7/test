function randomize(t)
	local count = 0
	for i,v in pairs(t) do
		count = count + 1
	end
	local chosen = math.random(1,count)
	count = 0
	for i,v in pairs(t) do
		count = count + 1
		if count == chosen then
			return v
		end
	end
end

function CreateSFX(Part, Sound,noplay)
	local SFX = createsound()
	SFX.SoundId = Sound.Id
	SFX.Volume = Sound.Vol or .5
	SFX.Pitch = Sound.Pitch or 1
	--SFX.PlaybackSpeed = (math.random(8,11) * .1)
	SFX.Parent = Part
	if not noplay then
		SFX:Play()
		game:GetService("Debris"):AddItem(SFX,SFX.TimeLength + 20)
	end
end
